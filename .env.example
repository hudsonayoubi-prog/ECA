# Education Channel Audit Tool (ECA) — environment settings
# The prototype is a static page and reads no environment variables at runtime.
# These placeholders document what the production (Power Apps / Dataverse) build must configure.

# --- Tests only ---------------------------------------------------------------
# Path to a Chromium/Chrome binary for Playwright. Leave blank to use Playwright's own browser.
CHROMIUM_PATH=

# --- Prototype --------------------------------------------------------------
# Admin step-up PIN. The prototype seeds a default in src/app.js (DEFAULT_REF.adminPin) and lets an
# Administrator change it in Settings. Treat the current value as known: change it in the live app.
# Production must replace the PIN with Entra ID MFA / Privileged Identity Management.
ECA_ADMIN_PIN=YOUR_ADMIN_PIN

# --- Production (Power Platform) ---------------------------------------------
DATAVERSE_ENVIRONMENT_URL=https://YOUR_ORG.crm6.dynamics.com
POWER_PLATFORM_ENVIRONMENT_ID=YOUR_ENVIRONMENT_ID
SHAREPOINT_REPORTS_LIBRARY=https://YOUR_TENANT.sharepoint.com/sites/YOUR_SITE/Shared%20Documents/ECA%20Reports
OUTLOOK_SENDER_MAILBOX=YOUR_SHARED_MAILBOX@redbull.com
TEAMS_RESULTS_CHANNEL_ID=YOUR_TEAMS_CHANNEL_ID
